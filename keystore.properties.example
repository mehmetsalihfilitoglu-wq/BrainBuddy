# EDUmio release signing — TEMPLATE.
#
# Copy this file to `keystore.properties` (same directory, repo root) and fill in the real values.
# `keystore.properties` is git-ignored and must NEVER be committed — it holds signing secrets.
#
# Do NOT generate a new keystore and do NOT change the signing certificate: `storeFile` points at the
# existing EDUmio release keystore (`edumio_release.jks`) at the repo root. Only the owner has the
# passwords. When this file (as keystore.properties) is absent, debug builds still work; a release build
# fails with a clear message (see app/build.gradle.kts).

storeFile=edumio_release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
