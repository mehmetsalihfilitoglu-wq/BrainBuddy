<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".app.MioAcademyApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainBuddy">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}"/>

        <!-- ── Core routing ── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".OnboardingWizardActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <!-- ── Error handling ── -->
        <activity
            android:name=".CrashActivity"
            android:exported="false" />

        <!-- ── Quiz engine ── -->
        <activity
            android:name=".quiz.QuizActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.QuizResultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.QuizRetryAdActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.WrongPoolActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.WrongAnswerReviewActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.WrongAnswersListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.WrongAnswersReportActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.PastTestDetailActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.QuestionImportActivity"
            android:exported="false" />

        <!-- ── Student hub & progress ── -->
        <activity
            android:name=".ui.StudyHubActivity"
            android:exported="false" />

        <activity
            android:name=".ui.GrowthHubActivity"
            android:exported="false" />

        <activity
            android:name=".ui.StudentProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.StudyAreasActivity"
            android:exported="false" />

        <!-- ── University & program discovery ── -->
        <activity
            android:name=".discover.DiscoverActivity"
            android:exported="false" />

        <activity
            android:name=".discover.UniversityDetailActivity"
            android:exported="false" />

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <!-- ── Analytics & reports ── -->
        <activity
            android:name=".ui.ReportsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ReportShareActivity"
            android:exported="false" />

        <!-- ── Settings & account ── -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BackupImportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PrivacyPolicyActivity"
            android:exported="false" />

        <!-- ── Social & gamification ── -->
        <activity
            android:name=".social.LeagueScreen"
            android:exported="false" />

        <activity
            android:name=".avatar.AvatarShopScreen"
            android:exported="false" />

        <activity
            android:name=".legal.LegalHubActivity"
            android:exported="false" />

        <activity
            android:name=".legal.LegalDocActivity"
            android:exported="false" />

        <activity
            android:name=".coach.CoachScreen"
            android:exported="false" />

        <!-- ── Ads ── -->
        <activity
            android:name=".ui.WatchAdToUnlockLastTestActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AdLimitReachedActivity"
            android:exported="false" />

        <!-- ── Developer / debug tools ── -->
        <activity
            android:name=".ui.DebugSeedStatusActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SeedAuditActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <activity
            android:name=".ui.PoolStatusActivity"
            android:exported="false" />

        <!-- ── File sharing provider ── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
