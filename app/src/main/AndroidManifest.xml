<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Broad package visibility is required for parental control / app blocking.
         See Play policy: core feature is device/app management by parent. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".app.BrainBuddyApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainBuddy">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <activity
            android:name=".CrashActivity"
            android:exported="false" />

        <activity
            android:name=".CrashRecoveryWarningActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EmergencyUnlockActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <activity
            android:name=".OnboardingWizardActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".SimpleHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BlockedAppsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TimeLimitsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.QuizSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ExamPackActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.QuestionImportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PinLockActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ParentHubActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ScreenTimeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TestSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PoolStatusActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SecurityActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProtectionInactiveActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.QuizActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.QuizResultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.WrongAnswerReviewActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.WrongAnswersListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.WrongAnswersReportActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".LockScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.PastTestDetailActivity"
            android:exported="false" />

        <!-- Debug-only seed status screen (launched from BrainBuddyApp; has no launcher intent). -->
        <activity
            android:name=".ui.DebugSeedStatusActivity"
            android:exported="false" />

        <receiver
            android:name=".receiver.PackageChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.SocialAppInstalledReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.BlockAppFromNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.DismissSocialNotifReceiver"
            android:exported="false" />

        <service
            android:name=".resilience.AccessibilityMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control accessibility monitoring" />
        </service>

        <receiver
            android:name=".resilience.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.brainbuddy.app.accessibility.ForegroundAppBlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_foreground_blocker" />
        </service>

        <receiver
            android:name=".deviceadmin.BrainBuddyDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".gate.GateActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".ui.PermissionsChecklistActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SystemHealthActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ReportShareActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PrivacyPolicyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AccessibilityUsageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BackupImportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ReportsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EmailReportsSetupActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.SchedulesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProfileManageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.StudentProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StudyHubActivity"
            android:exported="false" />
        <activity
            android:name=".ui.GrowthHubActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WatchAdToUnlockLastTestActivity"
            android:exported="false" />

        <activity
            android:name=".ui.WatchAdForParentViewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AdLimitReachedActivity"
            android:exported="false" />
        <activity
            android:name=".quiz.QuizRetryAdActivity"
            android:exported="false" />
        <activity
            android:name=".quiz.QuizCooldownActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProfileSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".coach.CoachScreen"
            android:exported="false" />

        <activity
            android:name=".classroom.ClassroomActivity"
            android:exported="false" />

        <activity
            android:name=".avatar.AvatarShopScreen"
            android:exported="false" />

        <activity
            android:name=".reward.RewardContractActivity"
            android:exported="false" />

        <activity
            android:name=".social.LeagueScreen"
            android:exported="false" />

        <activity
            android:name=".quiz.BossTestActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <activity
            android:name=".quiz.GateRetrySingleActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- BrainBuddy Junior (1. Sınıf Okuma-Yazma) -->
        <activity
            android:name=".junior.JuniorSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".junior.JuniorHubActivity"
            android:exported="false" />
        <activity
            android:name=".junior.LetterSoundMatchActivity"
            android:exported="false" />
        <activity
            android:name=".junior.SyllableBuilderActivity"
            android:exported="false" />
        <activity
            android:name=".junior.PictureToWordActivity"
            android:exported="false" />
        <activity
            android:name=".junior.LetterTracingActivity"
            android:exported="false" />
        <activity
            android:name=".junior.ReadAloudActivity"
            android:exported="false" />
        <activity
            android:name=".junior.JuniorProgressActivity"
            android:exported="false" />
        <activity
            android:name=".junior.JuniorReportActivity"
            android:exported="false" />

    </application>

</manifest>