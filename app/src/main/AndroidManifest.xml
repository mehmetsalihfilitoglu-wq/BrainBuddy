<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".BrainBuddyApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainBuddy">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <activity
            android:name=".CrashActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".SimpleHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BlockedAppsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TimeLimitsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.QuizSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ExamPackActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.QuestionImportActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PinLockActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ParentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProtectionInactiveActivity"
            android:exported="false" />

        <activity
            android:name=".quiz.QuizActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.QuizResultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".quiz.WrongAnswerReviewActivity"
            android:exported="false" />

        <activity
            android:name=".LockScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <receiver
            android:name=".resilience.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.brainbuddy.app.accessibility.ForegroundAppBlockerService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_foreground_blocker" />
        </service>

        <receiver
            android:name=".deviceadmin.BrainBuddyDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".gate.GateActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout" />

        <activity
            android:name=".ui.PermissionsChecklistActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ReportsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SchedulesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProfileManageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProfileSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".coach.CoachScreen"
            android:exported="false" />

        <activity
            android:name=".classroom.ClassroomActivity"
            android:exported="false" />

        <activity
            android:name=".avatar.AvatarShopScreen"
            android:exported="false" />

        <activity
            android:name=".reward.RewardContractActivity"
            android:exported="false" />

        <activity
            android:name=".social.LeagueScreen"
            android:exported="false" />

        <activity
            android:name=".quiz.BossTestActivity"
            android:exported="false"
            android:theme="@style/Theme.BrainBuddy" />

        <activity
            android:name=".quiz.GateRetrySingleActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />

        <!-- BrainBuddy Junior (1. Sınıf Okuma-Yazma) -->
        <activity
            android:name=".junior.JuniorSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".junior.JuniorHubActivity"
            android:exported="false" />
        <activity
            android:name=".junior.LetterSoundMatchActivity"
            android:exported="false" />
        <activity
            android:name=".junior.SyllableBuilderActivity"
            android:exported="false" />
        <activity
            android:name=".junior.PictureToWordActivity"
            android:exported="false" />
        <activity
            android:name=".junior.LetterTracingActivity"
            android:exported="false" />
        <activity
            android:name=".junior.ReadAloudActivity"
            android:exported="false" />
        <activity
            android:name=".junior.JuniorProgressActivity"
            android:exported="false" />
        <activity
            android:name=".junior.JuniorReportActivity"
            android:exported="false" />

    </application>

</manifest>