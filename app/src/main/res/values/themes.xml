<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        ISEEmio / Mioitalia Design System — Material3 theme.
        Primary: #10B981 (ISEEmio green)
        Secondary: #14B8A6 (teal accent)
        Surfaces: clean white + #F8FAFC variant
        Single source of truth — no hardcoded colors in layouts.
    -->
    <style name="Theme.BrainBuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/brand_secondary</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainer">@color/surface_variant</item>
        <item name="colorSurfaceVariant">@color/brand_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Outline -->
        <item name="colorOutlineVariant">@color/border</item>

        <!-- Window & system bars.
             targetSdk 35 enforces edge-to-edge on Android 15; the app's layouts
             are built for fitted windows, so we opt out and keep classic insets.
             Status bar: transparent over the light window gradient, dark icons.
             Nav bar: solid white with dark icons — clean production look. -->
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Default button style -->
        <item name="materialButtonStyle">@style/BBButton</item>

        <!-- Cohesive, subtle screen transitions across the whole app -->
        <item name="android:windowAnimationStyle">@style/Animation.Mio</item>
    </style>

</resources>
