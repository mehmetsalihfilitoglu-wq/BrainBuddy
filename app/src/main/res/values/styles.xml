<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== BrainBuddy Design System ========== -->

    <!-- Widget.BrainBuddy.Card: shared card style for Home + ParentHub + Reports.
         Premium look: 24dp radius, surface container bg, light stroke, soft elevation. -->
    <style name="Widget.BrainBuddy.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    <!-- Premium CTA card: primaryContainer bg for premium highlight -->
    <style name="Widget.BrainBuddy.Card.PremiumCTA" parent="Widget.BrainBuddy.Card">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:foreground">@null</item>
    </style>

    <!-- Reports typography: card titles (TitleMedium + semiBold) -->
    <style name="TextAppearance.BrainBuddy.Reports.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- Reports typography: descriptions (BodySmall/BodyMedium + onSurfaceVariant) -->
    <style name="TextAppearance.BrainBuddy.Reports.CardDescription" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.BrainBuddy.Reports.CardDescriptionSmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- Premium CTA card: title + body on primaryContainer -->
    <style name="TextAppearance.BrainBuddy.Reports.PremiumTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>
    <style name="TextAppearance.BrainBuddy.Reports.PremiumBody" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.BrainBuddy.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.BrainBuddy.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.BrainBuddy.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- ========== Legacy styles ========== -->

    <!-- Primary button: 56dp height, rounded -->
    <style name="PrimaryButtonStyle" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/bb_primary</item>
    </style>

    <!-- Card: 20dp radius, soft shadow -->
    <style name="CardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/bb_card</item>
    </style>

    <!-- Input: TextInputLayout + TextInputEditText -->
    <style name="InputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Design system: BrainBuddy turquoise theme -->
    <style name="BB" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bb_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bb_primary</item>
    </style>

    <!-- Card style: 20dp radius, soft shadow, 16-24dp padding -->
    <style name="BB.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>

    <!-- Section header: bold, large -->
    <style name="BB.SectionHeader">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bb_text</item>
    </style>

    <!-- Stat chip: light background, readable text (Material3-like, premium look) -->
    <style name="Widget.BrainBuddy.Chip.Stat" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/bb_surface_container</item>
        <item name="android:textColor">@color/bb_text</item>
        <item name="chipStrokeColor">@color/bb_outline_variant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <!-- Stat chip: medium, muted (legacy) -->
    <style name="BB.StatChip">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/bb_text_muted</item>
    </style>

    <!-- Primary button: 56dp height, rounded, white text -->
    <style name="BBButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/bb_primary</item>
    </style>

    <!-- Secondary outlined: Primary stroke -->
    <style name="BBButtonAlt" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bb_primary</item>
        <item name="strokeColor">@color/bb_primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="BB.Button" parent="BBButton"/>

    <!-- Home/standard card: uses shared BrainBuddy.Card design -->
    <style name="BB.HomeCard" parent="Widget.BrainBuddy.Card" />

    <!-- Home card chip: compact icon+text action -->
    <style name="BB.HomeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textColor">@color/bb_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Control row: icon + title + subtitle + chevron -->
    <style name="BB.ControlRow">
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

</resources>