<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ANA TEMA (BU YOKTU, HATA BURADAN GELİYORDU) -->
    <style name="BB" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bb_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bb_primary</item>
    </style>

    <!-- Kart stili -->
    <style name="BB.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Ana buton -->
    <style name="BBButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/bb_primary</item>
    </style>

    <!-- Alternatif buton -->
    <style name="BBButtonAlt" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bb_primary</item>
        <item name="strokeColor">@color/bb_primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="BB.Button" parent="BBButton"/>

    <style name="BB.HomeCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

</resources>