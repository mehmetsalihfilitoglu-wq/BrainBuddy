    <color name="divider">#1F2937</color>
    <color name="text_primary">#F9FAFB</color>
    <color name="text_secondary">#9CA3AF</color>
    <color name="text_tertiary">#6B7280</color>
    <color name="bb_card">#1F2937</color>
    <color name="bb_surface_container">@color/surface_variant</color>
    <color name="bb_outline_variant">@color/border</color>
</resources>
