<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme: flat dark window background; color tokens override via colors-night.xml -->
    <style name="Theme.BrainBuddy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_light</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/brand_secondary</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/white</item>

        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainer">@color/surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorOutlineVariant">@color/border</item>

        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="materialButtonStyle">@style/BBButton</item>
    </style>
</resources>
