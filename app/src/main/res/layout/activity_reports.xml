<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/reports_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="?attr/colorPrimary"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="@dimen/reports_screen_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- A) Haftalık Başarı kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeeklySuccess"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <LinearLayout
                        android:id="@+id/weeklySuccessContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/reports_title_content">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- 1) HEADER ROW -->
                            <TextView
                                android:id="@+id/tvWeeklySuccessTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/parent_weekly_success"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/chipWeeklyRange"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintHorizontal_bias="0"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWeeklyRange"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="false"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Son 7 gün"
                                android:textColor="?attr/colorOnSurface"
                                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>

                            <!-- 2) CHIP ROW -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWeeklyCorrect"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="false"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Doğru: 0"
                                android:textColor="?attr/colorOnSurface"
                                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                                app:layout_constraintTop_toBottomOf="@id/tvWeeklySuccessTitle"
                                app:layout_constraintStart_toStartOf="parent"
                                tools:text="Doğru: 57"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWeeklyWrong"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="false"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Yanlış: 0"
                                android:textColor="?attr/colorOnSurface"
                                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                                tools:text="Yanlış: 36"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWeeklyBlank"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="false"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Boş: 0"
                                android:textColor="?attr/colorOnSurface"
                                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                                tools:text="Boş: 74"/>

                            <androidx.constraintlayout.helper.widget.Flow
                                android:id="@+id/flowWeeklyChips"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:constraint_referenced_ids="chipWeeklyCorrect,chipWeeklyWrong,chipWeeklyBlank"
                                app:flow_wrapMode="chain"
                                app:flow_horizontalStyle="spread"
                                app:flow_horizontalGap="8dp"
                                app:flow_verticalGap="8dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvWeeklySuccessTitle"/>

                            <!-- Kept for binding/backwards compat: no longer shown -->
                            <TextView
                                android:id="@+id/tvWeeklyCorrectWrongBlank"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                tools:text="Doğru 12 / Yanlış 5 / Boş 3"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/flowWeeklyChips"/>

                            <!-- 3) KPI GRID -->
                            <LinearLayout
                                android:id="@+id/kpiTests"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <TextView
                                    android:id="@+id/tvDailyTests"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="11"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="Test"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/kpiAccuracy"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <TextView
                                    android:id="@+id/tvDailyAccuracy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="34%"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="Doğruluk"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/blockedRow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tvDailyBlocked"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorError"
                                    tools:text="44"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="Engellenen"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"/>
                            </LinearLayout>

                            <androidx.constraintlayout.helper.widget.Flow
                                android:id="@+id/flowWeeklyKpis"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:constraint_referenced_ids="kpiTests,kpiAccuracy,blockedRow"
                                app:flow_wrapMode="chain"
                                app:flow_horizontalStyle="spread"
                                app:flow_horizontalGap="24dp"
                                app:flow_verticalGap="12dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/flowWeeklyChips"
                                android:layout_marginTop="12dp"/>

                            <!-- 4) PROGRESS BAR (modern) -->
                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/weeklyProgress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="?attr/colorPrimary"
                                app:trackColor="?attr/colorSurfaceVariant"
                                app:trackThickness="8dp"
                                app:trackCornerRadius="4dp"
                                app:layout_constraintTop_toBottomOf="@id/flowWeeklyKpis"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/weeklySuccessEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="48sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Henüz haftalık veri yok"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeeklyEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- B) Konulara Göre (Doğru/Toplam) kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTopics"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_topic_performance"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <com.brainbuddy.app.ui.BarChartView
                        android:id="@+id/topicBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:minHeight="60dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/topicsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📚"
                            android:textSize="40sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Konu verisi için test çöz"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTopicsEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- C) Son 10 Test Başarı Trendi kartı (premium chart + empty state) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTrend"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <!-- 1) HEADER ROW -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTrendTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="@string/trend_chart_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tvTrendUnit"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_bias="0"/>

                        <TextView
                            android:id="@+id/tvTrendUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="%"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- 2) CONTENT AREA - State 1: DATA VARSA -->
                    <LinearLayout
                        android:id="@+id/trendContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:visibility="gone">

                        <com.brainbuddy.app.ui.LineChartView
                            android:id="@+id/weeklyTrendChart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/trend_chart_min_height"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvTrendCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="@string/trend_chart_caption"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                    </LinearLayout>

                    <!-- 2) CONTENT AREA - State 2: DATA YOKSA (Empty State) -->
                    <LinearLayout
                        android:id="@+id/trendEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp"
                        android:minHeight="@dimen/trend_chart_min_height"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_trending_up"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/tvTrendEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:text="@string/trend_empty_title"
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>

                        <TextView
                            android:id="@+id/tvTrendEmptySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:text="@string/trend_empty_subtitle"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrendEmptyCta"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:minHeight="48dp"
                            android:text="@string/btn_start_quiz"
                            android:textAllCaps="false"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- D) Son Testler kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecentTests"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Son Testler"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentTests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/recentTestsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝"
                            android:textSize="40sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Henüz tamamlanan test yok"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRecentTestsEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- E) Yanlış Cevapları İncele kartı (Premium CTA) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewWrong"
                style="@style/Widget.BrainBuddy.Card.PremiumCTA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:id="@+id/wrongHasData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_review"
                            app:tint="?attr/colorOnPrimaryContainer"
                            android:contentDescription="@null"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/parent_review_wrong"
                                android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.PremiumTitle"/>

                            <TextView
                                android:id="@+id/tvWrongSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/parent_review_wrong_desc"
                                android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.PremiumBody"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReviewWrongParent"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:layout_marginTop="8dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_detail"
                                android:textAllCaps="false"
                                app:icon="@drawable/ic_chevron_right"
                                app:iconGravity="textEnd"
                                app:iconSize="20dp"
                                app:iconTint="?attr/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wrongEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_review"
                        app:tint="?attr/colorOnPrimaryContainer"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/parent_no_wrong_record"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.PremiumBody"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWrongEmptyCta"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/btn_start_quiz"
                        android:textAllCaps="false"
                        app:iconTint="?attr/colorOnSecondaryContainer"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- En çok denenen uygulamalar card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApps"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reports_top_apps_title"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerTopApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/topAppsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱"
                            android:textSize="40sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="@string/reports_top_apps_empty_title"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/reports_top_apps_empty_subtitle"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Haftalık XP (Toplam XP) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:id="@+id/tvWeeklyXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/bb_turquoise"
                        android:text="Toplam XP: 0"
                        tools:text="Toplam XP: 320"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- E-posta Raporları -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="E-posta Raporları"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="E-posta raporları yakında."
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmailSetup"
                        style="@style/BBButtonAlt"
                        android:layout_marginTop="12dp"
                        android:text="Kuruluma Git"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Raporu Paylaş -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap"
                android:layout_marginBottom="@dimen/space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/report_share"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareReport"
                        style="@style/BBButtonAlt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paylaş"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
