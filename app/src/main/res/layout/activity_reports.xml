<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/reports_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="?attr/colorPrimary"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="@dimen/reports_screen_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- A) Haftalık Başarı kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeeklySuccess"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_weekly_success"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <LinearLayout
                        android:id="@+id/weeklySuccessContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/reports_title_content">

                        <TextView
                            android:id="@+id/tvWeeklyCorrectWrongBlank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"
                            tools:text="Doğru 12 / Yanlış 5 / Boş 3"/>

                        <com.brainbuddy.app.ui.MiniStackedBarView
                            android:id="@+id/miniStackedBar"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginTop="@dimen/reports_title_content"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvDailyTests"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bb_turquoise"
                                    tools:text="5"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Test"
                                    android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvDailyAccuracy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bb_turquoise"
                                    tools:text="60%"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Doğruluk"
                                    android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/blockedRow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <TextView
                                    android:id="@+id/tvDailyBlocked"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bb_error"
                                    tools:text="0"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Engellenen"
                                    android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/weeklySuccessEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="48sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Henüz haftalık veri yok"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeeklyEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- B) Konulara Göre (Doğru/Toplam) kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTopics"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_topic_performance"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <com.brainbuddy.app.ui.BarChartView
                        android:id="@+id/topicBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:minHeight="60dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/topicsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📚"
                            android:textSize="40sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Konu verisi için test çöz"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTopicsEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- C) Son 10 Test Başarı Trendi kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTrend"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Son 10 Test Başarı Trendi"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <com.brainbuddy.app.ui.LineChartView
                        android:id="@+id/weeklyTrendChart"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/trendEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈"
                            android:textSize="40sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Trend için en az 3 test çöz"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"
                            android:gravity="center"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrendEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- D) Son Testler kartı -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecentTests"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Son Testler"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentTests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"/>

                    <LinearLayout
                        android:id="@+id/recentTestsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝"
                            android:textSize="40sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/reports_title_content"
                            android:text="Henüz tamamlanan test yok"
                            android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRecentTestsEmptyCta"
                            style="@style/BBButtonAlt"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_start_quiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- E) Yanlış Cevapları İncele kartı (Premium CTA) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewWrong"
                style="@style/Widget.BrainBuddy.Card.PremiumCTA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:id="@+id/wrongHasData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_review"
                            app:tint="?attr/colorOnPrimaryContainer"
                            android:contentDescription="@null"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/parent_review_wrong"
                                android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.PremiumTitle"/>

                            <TextView
                                android:id="@+id/tvWrongSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/parent_review_wrong_desc"
                                android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.PremiumBody"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReviewWrongParent"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:layout_marginTop="8dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp"
                                android:text="@string/btn_detail"
                                android:textAllCaps="false"
                                app:icon="@drawable/ic_chevron_right"
                                app:iconGravity="textEnd"
                                app:iconSize="20dp"
                                app:iconTint="?attr/colorOnSecondaryContainer"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wrongEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_review"
                        app:tint="?attr/colorOnPrimaryContainer"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/parent_no_wrong_record"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.PremiumBody"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWrongEmptyCta"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/btn_start_quiz"
                        android:textAllCaps="false"
                        app:iconTint="?attr/colorOnSecondaryContainer"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- En çok denenen uygulamalar card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApps"
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="En çok denenen uygulamalar"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <com.brainbuddy.app.ui.BarChartView
                        android:id="@+id/appsBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="@dimen/reports_title_content"
                        android:minHeight="80dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Haftalık XP (Toplam XP) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:id="@+id/tvWeeklyXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/bb_turquoise"
                        android:text="Toplam XP: 0"
                        tools:text="Toplam XP: 320"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- E-posta Raporları -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="E-posta Raporları"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardTitle"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="E-posta raporları yakında."
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescriptionSmall"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmailSetup"
                        style="@style/BBButtonAlt"
                        android:layout_marginTop="12dp"
                        android:text="Kuruluma Git"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Raporu Paylaş -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BrainBuddy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/reports_card_gap"
                android:layout_marginBottom="@dimen/space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/reports_card_inner">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/report_share"
                        android:textAppearance="@style/TextAppearance.BrainBuddy.Reports.CardDescription"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareReport"
                        style="@style/BBButtonAlt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paylaş"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
