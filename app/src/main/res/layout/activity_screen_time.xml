<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bb_turquoise_dark"
            app:titleTextColor="@color/white"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white" />

        <!-- Bugün Kullanım kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvTodayUsageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bugün Kullanım"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTodayUsageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 120 dk"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary" />

                    <TextView
                        android:id="@+id/tvTodayUsageRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Kalan: 0 dk"
                        android:textSize="14sp"
                        android:textColor="@color/bb_text_muted" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressTodayUsage"
                    style="?attr/materialProgressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:progress="0"
                    android:max="100"
                    app:trackThickness="8dp"
                    app:indicatorColor="@color/bb_turquoise_dark"
                    app:trackColor="@color/bb_turquoise_light" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Günlük Limit kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Günlük Limit"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Çocuk telefonunu günde en fazla bu süre kadar kullanabilir."
                    android:textSize="13sp"
                    android:textColor="@color/bb_text_muted" />

                <TextView
                    android:id="@+id/tvMinutesValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="120 dk"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_primary" />

                <SeekBar
                    android:id="@+id/seekMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="180"
                    android:progress="120" />

                <TextView
                    android:id="@+id/tvMinutesRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0–180 dk arası"
                    android:textSize="12sp"
                    android:textColor="@color/bb_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Uyku Modu kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Uyku Modu"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bu saatler arasında erişim kısıtlıdır."
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Başlangıç"
                            android:textSize="12sp"
                            android:textColor="@color/bb_text_muted" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tvSleepStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/bb_primary"
                                android:text="22:00" />

                            <TextView
                                android:id="@+id/tvSleepStartStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:background="@drawable/bg_chip_neutral"
                                android:text="PASİF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/bb_text" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSleepStart"
                            style="@style/BBButtonAlt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Değiştir"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="18sp"
                        android:textColor="@color/bb_text_muted"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bitiş"
                            android:textSize="12sp"
                            android:textColor="@color/bb_text_muted" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tvSleepEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/bb_primary"
                                android:text="07:00" />

                            <TextView
                                android:id="@+id/tvSleepEndStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:background="@drawable/bg_chip_neutral"
                                android:text="PASİF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/bb_text" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSleepEnd"
                            style="@style/BBButtonAlt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Değiştir"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hızlı İzin kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bb_turquoise_light"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hızlı İzin"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Çocuğa şimdi anlık süre ver (limit/uyku kısıtını geçici olarak kaldırır)."
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_muted" />

                <TextView
                    android:id="@+id/tvQuickAllowCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Aktif izin yok"
                    android:textSize="13sp"
                    android:textColor="@color/bb_text" />

                <LinearLayout
                    android:id="@+id/layoutQuickAllowPremiumOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuick5"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 dk" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuick10"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="10 dk" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuick15"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="15 dk" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuick30"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="30 dk" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuickAllowPremiumHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Premium ile süre seçilebilir"
                    android:textSize="12sp"
                    android:textColor="@color/bb_text_muted"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantQuick"
                    style="@style/BBButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Şimdi 10 dk izin ver" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
