<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="bottom"
    android:paddingHorizontal="4dp">

    <!-- 2nd Place (left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/podium2ndCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/edu_silver_bg"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="@dimen/elevation_raised">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="16dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvPodiumMedal2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥈"
                android:textSize="28sp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgPodiumAvatar2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="4dp"
                    android:src="@drawable/avatar_mascot_brainy"
                    android:contentDescription="Avatar" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPodiumName2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/edu_text" />

            <TextView
                android:id="@+id/tvPodiumScore2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/edu_silver_text" />

            <TextView
                android:id="@+id/tvPodiumYou2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/edu_primary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 1st Place (center, taller) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/podium1stCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:layout_marginHorizontal="6dp"
        app:cardBackgroundColor="@color/edu_gold_bg"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="20dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvPodiumMedal1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥇"
                android:textSize="36sp" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgPodiumAvatar1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="4dp"
                    android:src="@drawable/avatar_mascot_brainy"
                    android:contentDescription="Avatar" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPodiumName1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/edu_text" />

            <TextView
                android:id="@+id/tvPodiumScore1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/edu_gold_text" />

            <TextView
                android:id="@+id/tvPodiumYou1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/edu_primary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3rd Place (right) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/podium3rdCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/edu_bronze_bg"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="@dimen/elevation_raised">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="16dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvPodiumMedal3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥉"
                android:textSize="28sp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/imgPodiumAvatar3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="4dp"
                    android:src="@drawable/avatar_mascot_brainy"
                    android:contentDescription="Avatar" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPodiumName3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/edu_text" />

            <TextView
                android:id="@+id/tvPodiumScore3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/edu_bronze_text" />

            <TextView
                android:id="@+id/tvPodiumYou3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/edu_primary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
