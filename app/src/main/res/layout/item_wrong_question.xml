<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/wqMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/edu_text_muted"/>

        <TextView
            android:id="@+id/wqStem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/edu_text_dark"/>

        <TextView
            android:id="@+id/wqStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/edu_text_muted"/>

        <!-- Actions are STACKED, not side by side. "Soruyu tekrar çöz" is 17 characters; in half of a
             card row it does not fit on one line on a 360dp phone, so it wrapped to a second line that
             the old hard 46dp height then cut off. Full-width buttons keep both labels on one line, at
             identical width and height, on every supported width and font scale. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/wqRetry"
                style="@style/Widget.EDUmio.WrongQuestion.Action"
                android:text="@string/sol_retry"/>

            <Button
                android:id="@+id/wqSolution"
                style="@style/Widget.EDUmio.WrongQuestion.Action"
                android:layout_marginTop="8dp"
                android:text="@string/sol_view"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
