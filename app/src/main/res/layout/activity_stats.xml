<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/BBButtonAlt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Geri"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="İstatistikler"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Genel"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text_dark"/>

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Seviye 1"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>

                <TextView
                    android:id="@+id/tvXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 XP"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 gün seri"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>

                <TextView
                    android:id="@+id/tvOverallAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Genel doğruluk: 0%"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En güçlü konular"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text_dark"/>

                <TextView
                    android:id="@+id/tvStrongTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="-"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Çalışılması gereken konular"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text_dark"/>

                <TextView
                    android:id="@+id/tvWeakTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="-"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Son 10 test doğruluğu"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text_dark"/>

                <TextView
                    android:id="@+id/tvRecentTrend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="-"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_dark_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
