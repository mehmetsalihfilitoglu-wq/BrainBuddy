<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bb_turquoise_dark"
            app:titleTextColor="@color/white"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white" />

        <!-- BLOK 1: Test Ayarları -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTestSettings"
            style="@style/Widget.BrainBuddy.AppCardWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_test_settings"
                    android:textAppearance="@style/TextAppearance.BrainBuddy.AppTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_test_sub"
                    android:textAppearance="@style/TextAppearance.BrainBuddy.AppSubtitle" />

                <!-- Sınıf Seviyesi (2-8, zorunlu) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_grade_level"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_grade_level_sub"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_muted" />

                    <TextView
                        android:id="@+id/tvSelectedGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Seçili Sınıf: -"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_turquoise_dark" />

                    <RadioGroup
                        android:id="@+id/testGradeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/testGrade2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testGrade3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="3"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testGrade4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="4"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testGrade5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="5"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testGrade6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="6"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testGrade7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="7"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testGrade8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="8"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Test Uzunluğu (20 sabit) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Test Uzunluğu"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 soru (sabit)"
                        android:textSize="14sp"
                        android:textColor="@color/bb_text_muted" />
                </LinearLayout>

                <!-- Zorluk -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zorluk"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text" />

                    <RadioGroup
                        android:id="@+id/testDifficultyGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/testDiffEasy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kolay"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testDiffMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Orta"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testDiffHard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Zor"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Minimum Başarı Oranı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_min_success_rate"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_min_success_rate_sub"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_muted" />

                    <RadioGroup
                        android:id="@+id/testSuccessRateGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/testSuccessRate50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/success_rate_50"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testSuccessRate60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/success_rate_60"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testSuccessRate70"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/success_rate_70"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testSuccessRate80"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/success_rate_80"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Quiz Aralığı -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_quiz_interval"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_quiz_interval_sub"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_muted" />

                    <RadioGroup
                        android:id="@+id/testQuizIntervalGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/testInterval30"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/interval_30"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testInterval45"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/interval_45"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/testInterval60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/interval_60"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BLOK 2: Soru / Sınav Paketleri -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPacks"
            style="@style/Widget.BrainBuddy.AppCardWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parent_question_packs"
                    android:textAppearance="@style/TextAppearance.BrainBuddy.AppTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/parent_question_packs_sub"
                    android:textAppearance="@style/TextAppearance.BrainBuddy.AppSubtitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_exam_packs"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/bb_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_exam_packs_sub"
                            android:textSize="12sp"
                            android:textColor="@color/bb_text_muted" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExamPacks"
                        style="@style/BBButtonAlt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paketleri Yönet"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BLOK 3: Eğitim Modülleri / İçerik -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEducation"
            style="@style/Widget.BrainBuddy.AppCardWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_education"
                    android:textAppearance="@style/TextAppearance.BrainBuddy.AppTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Test dışı modüller ve pratik kısayollar"
                    android:textAppearance="@style/TextAppearance.BrainBuddy.AppSubtitle" />

                <!-- BrainBuddy Junior -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJuniorModule"
                    style="@style/BB.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_junior_title"
                    android:textAllCaps="false" />

                <!-- Mini Test (Pratik) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniTest"
                    style="@style/BBButtonAlt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_practice"
                    android:textAllCaps="false" />

                <!-- Yanlışlardan Çalış -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWorkOnWrongs"
                    style="@style/BBButtonAlt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/parent_review_wrong"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
