<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding_h">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quiz_result_congrats"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text"
            android:gravity="center"/>

        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvScoreBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/10"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_primary"/>

        <TextView
            android:id="@+id/tvScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_result_correct_wrong_blank"
            android:textSize="16sp"
            android:textColor="@color/bb_text_muted"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%80"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/bb_primary"
            android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvPassFail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEÇTİ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/progressCircle"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/bb_primary"
                    android:progressBackgroundTint="@color/divider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/tvPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50 puan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"/>

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="🔥 3 gün seri"
                        android:textSize="16sp"
                        android:textColor="@color/bb_text"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seviye 1"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/bb_text_muted"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Wrong review conversion card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/reviewConversionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Lock icon + wrong count row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvReviewLockIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"/>

                    <TextView
                        android:id="@+id/tvReviewWrongCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text_dark"/>
                </LinearLayout>

                <!-- Quota dots -->
                <TextView
                    android:id="@+id/tvResultQuotaDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"
                    android:letterSpacing="0.2"/>

                <!-- Info text -->
                <TextView
                    android:id="@+id/tvReviewInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/bb_text_muted"
                    android:lineSpacingMultiplier="1.3"/>

                <!-- CTA button -->
                <Button
                    android:id="@+id/btnRetryWrong"
                    style="@style/BB.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/quiz_result_review_wrong"
                    android:textAllCaps="false"/>

                <!-- Premium upsell link -->
                <TextView
                    android:id="@+id/tvResultPremiumHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/bb_turquoise"
                    android:gravity="center"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/adRetrySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvAdRetryInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ad_retry_info"
                android:textSize="14sp"
                android:textColor="@color/bb_text_muted"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnWatchAd"
                style="@style/BBButtonAlt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/ad_watch_retry"
                android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remedialRetrySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnRemedialMiniTest"
                style="@style/BB.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_remedial_mini"
                android:textAllCaps="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnRetryTest"
            style="@style/BB.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/quiz_result_retry_test"
            android:textAllCaps="false"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnPlayAgain"
            style="@style/BB.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/quiz_result_play_again"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnHome"
            style="@style/BBButtonAlt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/quiz_result_home"
            android:textAllCaps="false"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wrongSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvWrongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_result_wrong_answers"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvWrongTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
