<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tebrikler! 🎉"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text"
            android:gravity="center"/>

        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvScoreBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/10"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_primary"/>

        <TextView
            android:id="@+id/tvScoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doğru | Yanlış | Boş"
            android:textSize="16sp"
            android:textColor="@color/bb_text_muted"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%80"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/bb_primary"
            android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvPassFail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEÇTİ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/progressCircle"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/bb_primary"
                    android:progressBackgroundTint="#E0E0E0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:id="@+id/tvPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+50 puan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"/>

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="🔥 3 gün seri"
                        android:textSize="16sp"
                        android:textColor="@color/bb_text"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seviye 1"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/bb_text_muted"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnRetryWrong"
            style="@style/BB.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Yanlışları İncele"
            android:textAllCaps="false"/>

        <LinearLayout
            android:id="@+id/adRetrySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvAdRetryInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ad_retry_info"
                android:textSize="14sp"
                android:textColor="@color/bb_text_muted"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnWatchAd"
                style="@style/BBButtonAlt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/ad_watch_retry"
                android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remedialRetrySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnRemedialMiniTest"
                style="@style/BB.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_remedial_mini"
                android:textAllCaps="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnRetryTest"
            style="@style/BB.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Testi Tekrarla"
            android:textAllCaps="false"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnPlayAgain"
            style="@style/BB.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Tekrar Oyna"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnHome"
            style="@style/BBButtonAlt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Ana Sayfa"
            android:textAllCaps="false"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wrongSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvWrongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yanlış cevaplar"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvWrongTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
