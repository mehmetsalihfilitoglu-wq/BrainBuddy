<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:gravity="center"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvFailedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_failed_title"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/bb_error"/>

            <TextView
                android:id="@+id/tvFailedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lock_failed_message"
                android:textSize="16sp"
                android:textColor="@color/bb_text_dark"
                android:gravity="center"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnPractice"
        style="@style/BB.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_practice"
        android:textAllCaps="false"/>

    <LinearLayout
        android:id="@+id/adRetrySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvAdRetryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reklam izleyerek bir yanlış soruyu tekrar cevaplayabilirsin."
            android:textSize="14sp"
            android:textColor="@color/bb_text_muted"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/btnWatchAd"
            style="@style/BBButtonAlt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Reklam İzle → Tekrar Dene"
            android:textAllCaps="false"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnPremiumRetry"
        style="@style/BBButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Premium → Reklamsız Tekrar"
        android:textAllCaps="false"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnRetryTest"
        style="@style/BB.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_retry_test"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btnParentPin"
        style="@style/BB.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_parent_unlock"
        android:textAllCaps="false"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnEmergencyUnlock"
        style="@style/BBButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/btn_emergency_unlock"
        android:textAllCaps="false"
        android:visibility="gone"/>
</LinearLayout>
