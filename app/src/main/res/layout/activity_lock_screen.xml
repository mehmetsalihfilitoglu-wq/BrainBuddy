<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:gravity="center"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvFailedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test Başarısız"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/bb_error"/>

            <TextView
                android:id="@+id/tvFailedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="3'ten fazla yanlış cevap verdin. Testi geçene kadar uygulama kilitli."
                android:textSize="16sp"
                android:textColor="@color/bb_text_dark"
                android:gravity="center"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnReviewWrong"
        style="@style/BB.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/retry_wrong"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btnRetryTest"
        style="@style/BB.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_retry_test"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btnPractice"
        style="@style/BBButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_practice"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btnParentPin"
        style="@style/BB.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_parent_unlock"
        android:textAllCaps="false"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnEmergencyUnlock"
        style="@style/BBButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/btn_emergency_unlock"
        android:textAllCaps="false"
        android:visibility="gone"/>
</LinearLayout>
