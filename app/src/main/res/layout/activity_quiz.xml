<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/page_padding_h">

        <com.google.android.material.chip.Chip
            android:id="@+id/subjectChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/quiz_subject_label"
            app:chipBackgroundColor="@color/edu_turquoise"
            app:chipStrokeColor="@color/edu_turquoise_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/progressText"
            app:layout_constraintHorizontal_chainStyle="spread_inside"/>

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/10"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/edu_turquoise"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/questionImage"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:minHeight="120dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/subjectChip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/questionImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiz_question_placeholder"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/edu_text_dark"
                android:lineSpacingMultiplier="1.2"
                android:padding="20dp"/>
        </com.google.android.material.card.MaterialCardView>

        <RadioGroup
            android:id="@+id/optionsGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/questionCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/optA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <RadioButton
                android:id="@+id/optB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <RadioButton
                android:id="@+id/optC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <RadioButton
                android:id="@+id/optD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <!-- 5th option: used by exams with A–E choices (e.g. IMAT). Hidden for 4-choice questions. -->
            <RadioButton
                android:id="@+id/optE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:visibility="gone"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>
        </RadioGroup>

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/quiz_feedback"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/optionsGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/submitBtn"
            style="@style/Edu.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/quiz_check_answer"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/optionsGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/nextBtn"
            style="@style/Edu.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/quiz_next"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/optionsGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Stub views for activities that hide hints (GateRetrySingleActivity, QuizActivityRetryWrong) -->
        <TextView android:id="@+id/hintTimer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <Button android:id="@+id/hintBtn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <TextView android:id="@+id/hintText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
