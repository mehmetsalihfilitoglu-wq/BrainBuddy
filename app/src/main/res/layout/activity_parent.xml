<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/parent_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text"/>

            <ImageButton
                android:id="@+id/btnPermissions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/parent_permissions"
                android:padding="8dp"
                android:src="@drawable/ic_permission"
                app:tint="@color/bb_primary"/>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/parent_settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings_24"
                app:tint="@color/bb_primary"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLastUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="12sp"
            android:textColor="@color/bb_text_muted"
            tools:text="Son güncelleme: 1 Mart 2025, 14:30"/>

        <!-- SECTION 1: Quick Summary Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bb_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/quickTestValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"
                        tools:text="5"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_quick_test"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_muted"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/quickAccuracyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"
                        tools:text="85"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_quick_success"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_muted"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/quickDenemeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_text"
                        tools:text="Instagram 0"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_quick_deneme"
                        android:textSize="12sp"
                        android:textColor="@color/bb_text_muted"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: Progress Card (Level/XP/Streak) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bb_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLevelNum"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"
                        tools:text="Seviye 1"/>

                    <TextView
                        android:id="@+id/tvXpNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_accent"
                        tools:text="150 XP"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvXpToNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/bb_text_muted"
                    tools:text="Seviye 2'ye 50 XP kaldı"/>

                <ProgressBar
                    android:id="@+id/progressToNextLevel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/bb_primary"
                    android:progressBackgroundTint="#20000000"/>

                <TextView
                    android:id="@+id/tvStreakNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text"
                    tools:text="🔥 Seri: 3 gün"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: Weekly Success Card (Donut + Counts) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bb_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parent_weekly_success"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <com.brainbuddy.app.ui.DonutChartView
                        android:id="@+id/donutChart"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        tools:progress="75"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="20dp">

                        <TextView
                            android:id="@+id/tvWeeklyCorrect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/bb_text"
                            tools:text="Doğru: 42"/>
                        <TextView
                            android:id="@+id/tvWeeklyWrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="@color/bb_text"
                            tools:text="Yanlış: 8"/>
                        <TextView
                            android:id="@+id/tvWeeklyBlank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="@color/bb_text"
                            tools:text="Boş: 0"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 4: Topic Performance Card (Bar Chart) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bb_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parent_topic_performance"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text"/>

                <com.brainbuddy.app.ui.BarChartView
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="140dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 5: Strong/Weak (Two cards side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/BB.HomeCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/bb_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_strong_topics"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"/>

                    <LinearLayout
                        android:id="@+id/containerStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/BB.HomeCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/bb_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_weak_topics"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_error"/>

                    <LinearLayout
                        android:id="@+id/containerWeak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- SECTION 6: Controls List -->
        <include layout="@layout/item_parent_control_row"
            android:id="@+id/controlReviewWrong"/>

        <include layout="@layout/item_parent_control_row"
            android:id="@+id/controlBlockedApps"/>

        <include layout="@layout/item_parent_control_row"
            android:id="@+id/controlTimeSettings"/>

        <include layout="@layout/item_parent_control_row"
            android:id="@+id/controlQuestionPacks"/>

        <include layout="@layout/item_parent_control_row"
            android:id="@+id/controlAvatarShop"/>

        <include layout="@layout/item_parent_control_row"
            android:id="@+id/controlChangePin"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
    </LinearLayout>
</ScrollView>
