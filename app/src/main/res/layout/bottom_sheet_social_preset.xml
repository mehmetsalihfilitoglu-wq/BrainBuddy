<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preset_social_confirm_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/bb_text"/>

    <TextView
        android:id="@+id/presetAppList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:textColor="@color/bb_text_muted"
        android:maxLines="6"
        android:ellipsize="end"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnPresetCancel"
            style="@style/BBButtonAlt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preset_cancel"/>

        <Button
            android:id="@+id/btnPresetConfirm"
            style="@style/BB.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/preset_confirm_block"/>
    </LinearLayout>
</LinearLayout>
