<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:id="@+id/tvCoachTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Koç Önerisi"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/bb_text_dark"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Günlük Öneri"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvDailyRec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="12dp"
        android:background="@drawable/bg_badge"
        android:textColor="@color/white"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Haftalık Plan"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvWeeklyPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="12dp"
        android:background="@drawable/bg_badge"
        android:textColor="@color/white"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnRemedial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Mini Tekrar Testi"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnCoachBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Geri"/>
</LinearLayout>
