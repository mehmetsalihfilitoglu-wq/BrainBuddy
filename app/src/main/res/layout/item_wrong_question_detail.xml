<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bb_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Locked state: title + subtitle + lock icon -->
        <LinearLayout
            android:id="@+id/layoutLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLockedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wrong_detail_locked_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text"/>

            <TextView
                android:id="@+id/tvLockedSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wrong_detail_tap_to_unlock"
                android:textSize="13sp"
                android:textColor="@color/bb_text_muted"/>

            <TextView
                android:id="@+id/tvLockedIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wrong_detail_locked_badge"
                android:textSize="12sp"
                android:textColor="@color/bb_text_muted"/>
        </LinearLayout>

        <!-- Unlocked state: question + user choice (+ optional correct for parent) -->
        <LinearLayout
            android:id="@+id/layoutUnlocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/bb_text"
                android:maxLines="10"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvUserChoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="@color/bb_error"/>

            <TextView
                android:id="@+id/tvCorrect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="@color/bb_turquoise"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/bb_text_muted"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
