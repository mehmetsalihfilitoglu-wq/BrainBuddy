<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/BBButtonAlt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_back"/>

        <!-- Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/bb_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Avatar Preview with ring -->
                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="132dp">

                    <!-- Ring background -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_preview_ring"/>

                    <!-- Avatar image -->
                    <ImageView
                        android:id="@+id/avatarPreview"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/avatar_mascot_brainy"
                        android:contentDescription="Avatar"/>
                </FrameLayout>

                <!-- Avatar name badge -->
                <TextView
                    android:id="@+id/tvAvatarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Brainy"
                    android:textSize="13sp"
                    android:textColor="@color/bb_primary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_rarity_badge"
                    android:backgroundTint="@color/emeraldSoft"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

                <EditText
                    android:id="@+id/etDisplayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/student_profile_name_hint"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:background="@drawable/bg_edit"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btnSaveName"
                    style="@style/BBButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_save"/>

                <!-- Stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seviye 1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bb_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="•"
                        android:textColor="@color/bb_text_muted"/>

                    <TextView
                        android:id="@+id/tvXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="0 XP"
                        android:textSize="14sp"
                        android:textColor="@color/bb_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="•"
                        android:textColor="@color/bb_text_muted"/>

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/bb_text"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/student_profile_avatars"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text"/>

            <TextView
                android:id="@+id/tvAvatarCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/bb_text_muted"/>
        </LinearLayout>

        <!-- Avatar grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAvatars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</ScrollView>
