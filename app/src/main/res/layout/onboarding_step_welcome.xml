<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/bg_onboarding_welcome">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🇮🇹"
        android:textSize="72sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Benvenuto!"
        android:textSize="36sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="İtalya'da okumak hayalini kuruyorsun."
        android:textSize="16sp"
        android:textColor="@color/text_on_emerald_muted"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mioitalia seni oraya götürür.\nİtalya yolculuğun burada başlıyor."
        android:textSize="14sp"
        android:textColor="@color/text_on_brand_tertiary"
        android:gravity="center"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
