<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bb_turquoise_dark"
        app:title="Sen Oku"
        app:titleTextColor="@color/white"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Kelimeyi yüksek sesle oku!"
        android:textColor="@color/bb_text_dark"
        android:textSize="20sp"/>

    <com.google.android.material.card.MaterialCardView
        style="@style/BB.HomeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/bb_turquoise_light">

        <TextView
            android:id="@+id/tvWordToRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="48dp"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text_dark"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnListen"
        style="@style/BBButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="🔊 Dinle"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRead"
        style="@style/BBButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="80dp"
        android:text="🎤 Ben Okuyacağım"
        android:textSize="20sp"/>
</LinearLayout>
