<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardQuickSettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_16"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/emerald_primary"
    app:strokeWidth="1.5dp"
    app:cardCornerRadius="@dimen/app_card_radius"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/emerald_primary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/quick_settings_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bb_text"/>
        </LinearLayout>

        <!-- a) Uygulama engelleme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_12">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_protection_on"
                android:textSize="14sp"
                android:textColor="@color/bb_text"/>

            <Switch
                android:id="@+id/quickSwitchAppBlocking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- b) Quiz aralığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/settings_quiz_interval"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text"/>

        <RadioGroup
            android:id="@+id/quickQuizIntervalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_4">

            <RadioButton
                android:id="@+id/quickInterval30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_12"
                android:text="@string/interval_30"
                android:textColor="@color/bb_text"/>

            <RadioButton
                android:id="@+id/quickInterval45"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_12"
                android:text="@string/interval_45"
                android:textColor="@color/bb_text"/>

            <RadioButton
                android:id="@+id/quickInterval60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interval_60"
                android:textColor="@color/bb_text"/>
        </RadioGroup>

        <!-- c) Minimum başarı oranı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/settings_min_success_rate"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text"/>

        <RadioGroup
            android:id="@+id/quickSuccessRateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_4">

            <RadioButton
                android:id="@+id/quickSuccessRate50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:text="@string/success_rate_50"
                android:textColor="@color/bb_text"/>

            <RadioButton
                android:id="@+id/quickSuccessRate60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:text="@string/success_rate_60"
                android:textColor="@color/bb_text"/>

            <RadioButton
                android:id="@+id/quickSuccessRate70"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_8"
                android:text="@string/success_rate_70"
                android:textColor="@color/bb_text"/>

            <RadioButton
                android:id="@+id/quickSuccessRate80"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/success_rate_80"
                android:textColor="@color/bb_text"/>
        </RadioGroup>

        <!-- d, e, f) Satırlar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_8"
            android:background="@color/emerald_light"/>

        <LinearLayout
            android:id="@+id/rowBlockedApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/space_8"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_block"
                app:tint="@color/emerald_primary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_12"
                android:text="@string/quick_settings_blocked_apps"
                android:textSize="14sp"
                android:textColor="@color/bb_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="18sp"
                android:textColor="@color/emerald_primary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTimeLimits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/space_8"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_timer"
                app:tint="@color/emerald_primary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_12"
                android:text="@string/settings_time_limits"
                android:textSize="14sp"
                android:textColor="@color/bb_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="18sp"
                android:textColor="@color/emerald_primary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/space_8"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_avatar"
                app:tint="@color/emerald_primary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_12"
                android:text="@string/quick_settings_profiles"
                android:textSize="14sp"
                android:textColor="@color/bb_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="18sp"
                android:textColor="@color/emerald_primary"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
