<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ Güvenlik Uyarısı"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/bb_text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Uygulama tekrarlayan çökmeler nedeniyle geçici olarak yeniden başlatıldı. Sorun devam ederse uygulamayı kapatıp tekrar açın."
        android:textSize="16sp"
        android:textColor="@color/bb_text_muted"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnOk"
        style="@style/BB.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tamam"/>
</LinearLayout>
