<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/BBButtonAlt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Geri"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/subjectChip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="İnceleme"
            app:chipBackgroundColor="@color/bb_turquoise"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toStartOf="@id/headerRight"/>

        <LinearLayout
            android:id="@+id/headerRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/5"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bb_turquoise"/>

            <TextView
                android:id="@+id/tvQuotaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/bb_text_muted"
                tools:text="Günlük kalan: 2"/>

            <TextView
                android:id="@+id/tvHintWatchAd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wrong_review_hint_watch_ad"
                android:textSize="11sp"
                android:textColor="@color/bb_turquoise"
                android:visibility="gone"
                tools:visibility="visible"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/subjectChip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Soru"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_text_dark"
                    android:lineSpacingMultiplier="1.2"/>

                <ImageView
                    android:id="@+id/questionImage"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@null"/>

                <LinearLayout
                    android:id="@+id/summarySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvUserChoiceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/bb_error"/>

                    <TextView
                        android:id="@+id/tvCorrectSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:textColor="@color/bb_turquoise"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvHintSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/bb_text_muted"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btnRetryQuestion"
                        style="@style/BBButtonAlt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tekrar Dene"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <RadioGroup
            android:id="@+id/optionsGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/questionCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/optA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/bb_text_dark"/>
            <RadioButton
                android:id="@+id/optB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/bb_text_dark"/>
            <RadioButton
                android:id="@+id/optC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/bb_text_dark"/>
            <RadioButton
                android:id="@+id/optD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/bb_text_dark"/>
        </RadioGroup>

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/optionsGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/nextBtn"
            style="@style/BB.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Sonraki"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/feedbackText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
