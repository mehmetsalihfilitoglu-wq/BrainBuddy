<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_32">

        <!-- ─── HEADER: Greeting + Date + Settings ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buongiorno!"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_settings"
                android:padding="12dp"
                app:tint="@color/textSecondary"
                android:contentDescription="@null"/>
        </LinearLayout>

        <!-- ─── TODAY'S CHALLENGE (Günün Görevi) — daily habit hero ─── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dcHomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            app:cardCornerRadius="@dimen/app_card_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/brand_primary_light"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/dcHomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dc_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary_dark"/>

                <TextView
                    android:id="@+id/dcHomeState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dc_card_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"/>

                <ProgressBar
                    android:id="@+id/dcHomeProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="5"
                    android:progress="0"
                    android:progressTint="@color/brand_primary"/>

                <TextView
                    android:id="@+id/dcHomeMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:id="@+id/dcHomeCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary_dark"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/dcHomeCta"
                    style="@style/BB.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/dc_cta_start"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── TODAY'S NEXT STEP — the one decided action ─── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            app:cardCornerRadius="@dimen/app_card_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_24"
                android:background="@drawable/bg_onboarding_welcome">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_next_step_label"
                    android:textSize="10sp"
                    android:textColor="@color/text_on_emerald_muted"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/space_8"/>

                <TextView
                    android:id="@+id/tvStepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:lineSpacingMultiplier="1.15"/>

                <TextView
                    android:id="@+id/tvStepMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="13sp"
                    android:textColor="@color/text_on_emerald_muted"
                    android:layout_marginTop="@dimen/space_8"/>

                <ProgressBar
                    android:id="@+id/missionProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:max="2"
                    android:progress="0"
                    android:progressTint="@color/white"
                    android:progressBackgroundTint="@color/divider_on_brand"/>

                <TextView
                    android:id="@+id/tvMissionProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="@color/text_on_emerald_muted"
                    android:layout_marginTop="@dimen/space_4"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepStart"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/home_step_start"
                    android:textSize="16sp"
                    android:textColor="@color/emeraldDark"
                    style="@style/Widget.MaterialComponents.Button"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── COMPACT STATUS — how am I doing (tap → active-area switcher) ─── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIdentityHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCareerIdentity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎓 Gelecekteki Öğrenci"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"/>

                    <TextView
                        android:id="@+id/tvSwitchAreaHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_active_area_hint"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/emeraldDark"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawableTint="@color/emeraldDark"
                        android:drawablePadding="2dp"
                        android:paddingStart="@dimen/space_8"/>
                </LinearLayout>

                <!-- Degree line (kept, small) -->
                <TextView
                    android:id="@+id/tvItalianDegree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp"/>

                <!-- Stats row: Streak | XP | Level -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_12">

                    <TextView
                        android:id="@+id/streakBadge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔥 0 gün"
                        android:textSize="12sp"
                        android:textColor="@color/textPrimary"
                        android:gravity="center"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="@color/border"/>

                    <TextView
                        android:id="@+id/pointsBadge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⭐ 0 XP"
                        android:textSize="12sp"
                        android:textColor="@color/textPrimary"
                        android:gravity="center"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="@color/border"/>

                    <TextView
                        android:id="@+id/levelBadge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lv. 1"
                        android:textSize="12sp"
                        android:textColor="@color/textPrimary"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── DAILY INSIGHT (real-data; hidden when no data) ─── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHomeInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/emeraldSoft"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvHomeInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_16"
                android:textSize="13sp"
                android:textColor="@color/emeraldDark"
                android:lineSpacingMultiplier="1.35"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─── SECONDARY NAV ROW (Study | Progress | Profile) ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_4"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_quiz"
                        app:tint="@color/emerald"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nav_study"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginTop="@dimen/space_8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_4"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_stats"
                        app:tint="@color/emerald"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nav_progress"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginTop="@dimen/space_8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_avatar"
                        app:tint="@color/emerald"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nav_profile"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginTop="@dimen/space_8"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ─── WRONG POOL CARD (conditional) ─── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWrongPool"
            style="@style/Widget.BrainBuddy.AppCardWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_accent_bar_height"
                    android:background="@color/bb_error"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_quiz"
                        app:tint="@color/bb_error"
                        android:contentDescription="@null"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wrong_pool_home_title"
                            style="@style/TextAppearance.BrainBuddy.AppTitle"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="@string/wrong_pool_home_sub"
                            style="@style/TextAppearance.BrainBuddy.AppSubtitle"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
