<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Left: app icon container -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circle_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="?attr/colorPrimary" />
    </FrameLayout>

    <!-- Right: value (attempt count) -->
    <TextView
        android:id="@+id/tvAttemptCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minEms="4"
        android:gravity="end"
        android:textAlignment="viewEnd"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Middle: title + tiny progress -->
    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintEnd_toStartOf="@id/tvAttemptCount"
        app:layout_constraintTop_toTopOf="@id/iconContainer"
        app:layout_constraintBottom_toBottomOf="@id/iconContainer">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUsage"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:indeterminate="false"
            app:trackThickness="6dp"
            app:trackCornerRadius="3dp"
            app:indicatorColor="@color/emerald_primary"
            app:trackColor="@color/emerald_light" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

