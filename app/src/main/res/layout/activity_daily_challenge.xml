<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dcFlowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/page_padding_h"
        android:paddingVertical="@dimen/space_24">

        <TextView
            android:id="@+id/dcExamLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/dc_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/edu_turquoise"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dcProgressText"/>

        <TextView
            android:id="@+id/dcProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/edu_text_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ProgressBar
            android:id="@+id/dcProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="5"
            android:progress="1"
            android:progressTint="@color/edu_turquoise"
            app:layout_constraintTop_toBottomOf="@id/dcExamLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/dcQuestionImage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/dc_cd_question_figure"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/dcProgressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dcQuestionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/dcQuestionImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/dcQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dc_question_placeholder"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/edu_text_dark"
                android:lineSpacingMultiplier="1.2"
                android:padding="20dp"/>
        </com.google.android.material.card.MaterialCardView>

        <RadioGroup
            android:id="@+id/dcOptionsGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/dcQuestionCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/dcOptA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <RadioButton
                android:id="@+id/dcOptB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <RadioButton
                android:id="@+id/dcOptC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <RadioButton
                android:id="@+id/dcOptD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>

            <!-- 5th option: shown only for A–E (IMAT-format) questions. -->
            <RadioButton
                android:id="@+id/dcOptE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="16dp"
                android:visibility="gone"
                android:background="@drawable/bg_choice_button"
                android:textSize="16sp"
                android:textColor="@color/edu_text_dark"/>
        </RadioGroup>

        <Button
            android:id="@+id/dcNextBtn"
            style="@style/Edu.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/dc_next"
            android:enabled="false"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/dcOptionsGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
