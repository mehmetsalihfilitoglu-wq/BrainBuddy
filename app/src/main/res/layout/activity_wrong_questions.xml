<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wp_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/edu_text_dark"/>

        <!-- Counters as three compact statistic cards. baselineAligned=false + match_parent card
             heights make all three exactly as tall as the tallest, so the row stays balanced when a
             label wraps at a large font scale. Read-only: no click handling anywhere on this row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="12dp">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.EDUmio.StatCard">
                <LinearLayout style="@style/Widget.EDUmio.StatCardContent">
                    <TextView
                        android:id="@+id/wpActive"
                        style="@style/Widget.EDUmio.StatCardValue"
                        tools:text="2"/>
                    <TextView
                        style="@style/Widget.EDUmio.StatCardLabel"
                        android:text="@string/wp_active_count"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EDUmio.StatCard"
                android:layout_marginStart="8dp">
                <LinearLayout style="@style/Widget.EDUmio.StatCardContent">
                    <TextView
                        android:id="@+id/wpDue"
                        style="@style/Widget.EDUmio.StatCardValue"
                        tools:text="2"/>
                    <TextView
                        style="@style/Widget.EDUmio.StatCardLabel"
                        android:text="@string/wp_due_count"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EDUmio.StatCard"
                android:layout_marginStart="8dp">
                <LinearLayout style="@style/Widget.EDUmio.StatCardContent">
                    <TextView
                        android:id="@+id/wpResolved"
                        style="@style/Widget.EDUmio.StatCardValue"
                        tools:text="0"/>
                    <TextView
                        style="@style/Widget.EDUmio.StatCardLabel"
                        android:text="@string/wp_resolved_count"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- exam filter chips -->
        <LinearLayout
            android:id="@+id/wpExamFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"/>

        <!-- sort chips -->
        <LinearLayout
            android:id="@+id/wpSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_h"
            android:paddingEnd="@dimen/page_padding_h"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/wpList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- empty state -->
            <LinearLayout
                android:id="@+id/wpEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/ic_edumio_mascot_happy"
                    android:contentDescription="@string/dc_cd_mascot"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/wp_empty"
                    android:textSize="15sp"
                    android:textColor="@color/edu_text_muted"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- error state: the queries FAILED. Deliberately distinct from the empty state above —
                 a database failure must never be reported as "no wrong questions, keep it up!". -->
            <LinearLayout
                android:id="@+id/wpError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wp_load_error"
                    android:textSize="15sp"
                    android:textColor="@color/edu_text_muted"
                    android:gravity="center"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wpErrorRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/dc_cta_retry"/>
            </LinearLayout>

            <!-- locked (Free) state: counts stay visible, list/actions do not -->
            <LinearLayout
                android:id="@+id/wpLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/ic_edumio_mascot_thoughtful"
                    android:contentDescription="@string/dc_cd_mascot"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/sol_locked_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/edu_text_dark"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/wp_locked_body"
                    android:textSize="14sp"
                    android:textColor="@color/edu_text_muted"
                    android:gravity="center"/>
                <Button
                    android:id="@+id/wpLockedCta"
                    style="@style/Edu.Button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/sol_locked_cta"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
