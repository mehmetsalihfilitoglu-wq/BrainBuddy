<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAvatar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bb_card"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Avatar image area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="Avatar"/>

            <!-- Lock overlay -->
            <View
                android:id="@+id/lockOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55FFFFFF"
                android:visibility="gone"/>

            <!-- Lock icon -->
            <ImageView
                android:id="@+id/lockIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_small"
                android:visibility="gone"
                android:contentDescription="Kilitli"/>

            <!-- Rarity indicator dot -->
            <View
                android:id="@+id/rarityDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="0dp"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Avatar name -->
        <TextView
            android:id="@+id/tvAvatarName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/bb_text"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Unlock requirement label (shown when locked) -->
        <TextView
            android:id="@+id/tvUnlockLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:paddingTop="2dp"
            android:textSize="10sp"
            android:textColor="@color/bb_text_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
