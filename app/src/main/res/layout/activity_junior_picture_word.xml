<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bb_turquoise_dark"
        app:title="Resimden Kelime"
        app:titleTextColor="@color/white"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Resme bak, kelimeyi seç! Dokun, dinle."
        android:textColor="@color/bb_text_dark"
        android:textSize="18sp"/>

    <com.google.android.material.card.MaterialCardView
        style="@style/BB.HomeCard"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/bb_turquoise_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPicture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="72sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeakWord"
                style="@style/BBButtonAlt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔊 Dinle"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWord1"
            style="@style/BBButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minHeight="72dp"
            android:textSize="24sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWord2"
            style="@style/BBButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minHeight="72dp"
            android:textSize="24sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWord3"
            style="@style/BBButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minHeight="72dp"
            android:textSize="24sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWord4"
            style="@style/BBButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:minHeight="72dp"
            android:textSize="24sp"/>
    </LinearLayout>
</LinearLayout>
