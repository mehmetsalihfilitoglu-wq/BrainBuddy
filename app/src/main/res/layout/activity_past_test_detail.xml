<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Detayı"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text"/>

        <com.google.android.material.card.MaterialCardView
            style="@style/BB.HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/20"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/bb_primary"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 Mart 2025"
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_muted"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvSubjectBreakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/bb_text_muted"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvWrongLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yanlış Sorular"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bb_text"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/layoutViewQuotaGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:background="@color/bb_turquoise_light">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doğru cevapları görmek için reklam izleyerek 1 hak kazanın."
                android:textSize="14sp"
                android:textColor="@color/bb_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchAdForView"
                style="@style/BBButtonAlt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_watch_ad_unlock"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tekrar Çöz"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            android:layout_marginTop="24dp"/>

        <LinearLayout
            android:id="@+id/layoutLimitReached"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvLimitReached"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ad_limit_reached_message"
                android:textSize="15sp"
                android:textColor="@color/bb_text_muted"
                android:gravity="center"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremiumCta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Premium ile sınırsız erişim"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Geri"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
