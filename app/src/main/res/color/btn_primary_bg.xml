<?xml version="1.0" encoding="utf-8"?>
<!-- Primary-button fill. A DISABLED button must never look pressable (UX rule 2): it goes flat grey
     instead of staying brand green, which is what the previous fixed ?attr/colorPrimary tint did. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/divider" />
    <item android:color="@color/brand_primary" />
</selector>
