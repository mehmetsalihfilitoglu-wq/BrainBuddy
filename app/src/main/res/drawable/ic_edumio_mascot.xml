<?xml version="1.0" encoding="utf-8"?>
<!--
  EDUmio official mascot — vector interpretation of the brand character:
  rounded green body, black graduation mortarboard + green tassel, two large eyes.
  108x108 viewport (adaptive-icon friendly); the mascot sits within the ~66dp safe zone.
  Reused for the launcher foreground, splash, and in-app illustrations.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- base / neck nub (behind body) -->
    <path android:pathData="M48,78 L60,78 L57.5,88 L50.5,88 Z" android:fillColor="#159A45" />

    <!-- body (green vertical gradient) -->
    <path android:pathData="M42,42 h24 a16,16 0 0 1 16,16 v8 a16,16 0 0 1 -16,16 h-24 a16,16 0 0 1 -16,-16 v-8 a16,16 0 0 1 16,-16 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="42" android:endX="54" android:endY="82">
                <item android:offset="0.0" android:color="#FF45DD70" />
                <item android:offset="1.0" android:color="#FF1CA84C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- graduation cap: black mortarboard (flat diamond) -->
    <path android:pathData="M54,32 L84,43 L54,50 L24,43 Z" android:fillColor="#202124" />
    <!-- cap tassel: cord + green bob on the right -->
    <path android:pathData="M82.5,44 h2 v11 h-2 Z" android:fillColor="#1CA84C" />
    <path android:pathData="M80.5,55 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" android:fillColor="#25D366" />
    <!-- cap button (green knob) on top -->
    <path android:pathData="M49,27 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" android:fillColor="#25D366" />
    <path android:pathData="M51.5,26 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" android:fillColor="#3CE06A" />

    <!-- eyes: white -->
    <path android:pathData="M45,50 a8,10 0 1,0 0,20 a8,10 0 1,0 0,-20 Z" android:fillColor="#FFFFFF" />
    <path android:pathData="M63,50 a8,10 0 1,0 0,20 a8,10 0 1,0 0,-20 Z" android:fillColor="#FFFFFF" />
    <!-- pupils: dark, shifted slightly (friendly gaze) -->
    <path android:pathData="M42.5,61 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z" android:fillColor="#1C1C1E" />
    <path android:pathData="M60.5,61 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z" android:fillColor="#1C1C1E" />
    <!-- highlights -->
    <path android:pathData="M47,58 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z" android:fillColor="#FFFFFF" />
    <path android:pathData="M65,58 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z" android:fillColor="#FFFFFF" />

    <!-- mouth: subtle -->
    <path android:pathData="M49.5,74 h9 a1.5,1.5 0 0 1 0,3 h-9 a1.5,1.5 0 0 1 0,-3 Z" android:fillColor="#12913F" />
</vector>
