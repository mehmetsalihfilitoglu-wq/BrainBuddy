<?xml version="1.0" encoding="utf-8"?>
<!-- The ONE filter/segmented-control chip background for the whole app.
     Selected = filled brand colour (unmistakable); unselected = quiet surface + hairline border.
     State-driven, so a caller only sets isSelected and the visual follows. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECTED: filled accent — never a subtle tint (UX rule 1 & 4). -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary" />
            <corners android:radius="@dimen/chip_corner_radius" />
        </shape>
    </item>

    <!-- PRESSED (unselected): soft accent wash so the tap is felt (UX rule 9). -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_primary_light" />
            <stroke android:width="1dp" android:color="@color/brand_primary" />
            <corners android:radius="@dimen/chip_corner_radius" />
        </shape>
    </item>

    <!-- DEFAULT: quiet, clearly "not chosen", but still reads as a control. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="@dimen/chip_corner_radius" />
        </shape>
    </item>

</selector>
