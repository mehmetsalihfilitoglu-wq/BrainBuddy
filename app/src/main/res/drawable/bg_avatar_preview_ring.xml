<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow / shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#221BC5B0"/>
            <size android:width="132dp" android:height="132dp"/>
        </shape>
    </item>
    <!-- Ring border -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#1BC5B0"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
    <!-- Inner white background -->
    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>
